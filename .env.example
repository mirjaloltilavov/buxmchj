APP_NAME="Buxgalter MChJ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://new.buxmchj.uz
APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_TIMEZONE=Asia/Tashkent

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Plesk → Базы данных da yaratilgan MySQL ma'lumotlari
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Admin panel (https://new.buxmchj.uz/admin) uchun birinchi foydalanuvchi.
# "php artisan site:install" shu ma'lumotlar bilan adminni yaratadi.
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_MAILER=log
